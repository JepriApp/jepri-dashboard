# ─────────────────────────────────────────────────────────────
# Credenciales de CLI para ESTE proyecto (jepri-dashboard).
# Git-ignored (.env*.local). NO son las cuentas personales de
# los conectores de Claude — son las cuentas de Jepri.
#
# Cargar en la shell antes de usar los CLIs:
#   set -a; source .env.cli.local; set +a
# o usar el helper:  source ./scripts/use-jepri-cli.sh
# ─────────────────────────────────────────────────────────────

# --- Supabase ---
# Access token: https://supabase.com/dashboard/account/tokens  (logueá con la cuenta de Jepri)
SUPABASE_ACCESS_TOKEN=sbp_...
# Ref del proyecto Supabase "Neptuno" (el de jepri-dashboard)
SUPABASE_PROJECT_ID=<your-supabase-project-id>

# --- Vercel ---
# Ya hiciste `vercel login` (cuenta devserv-4885, team "Jepri's projects").
# El login global alcanza para uso local; dejá VERCEL_TOKEN vacío salvo para CI.
# Token para CI: https://vercel.com/account/tokens  (Scope: Jepri's projects)
VERCEL_TOKEN=
# Verificados con `vercel link` -> .vercel/project.json:
VERCEL_ORG_ID=team_...
VERCEL_PROJECT_ID=prj_...
