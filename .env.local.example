# Created by Vercel CLI
VERCEL_OIDC_TOKEN=<your-vercel-oidc-token>


# Prod database
PROD_STRING_CONNECTION=<your-prod-string-connection>

# Local self-hosted Supabase (10.85.96.51) — instancia recreada desde el backup de Neptuno
NEXT_PUBLIC_SUPABASE_URL=<your-local-dev-supabase-url>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-local-dev-supabase-publishable-key>

# Siigo configuration
SIIGO_API_ACCESS_KEY=<your-siigo-api-access-key>
SIIGO_API_USERNAME=<your-siigo-username>
SIIGO_API_BASE_URL=https://api.siigo.com/ 
SIIGO_PARTNER_ID=<your-siigo-partner-id>
SIIGO_DOCUMENT_ID=28938
SIIGO_SELLER_ID=801
SIIGO_PAYMENT_ID=8522
# Solo si la forma de pago (SIIGO_PAYMENT_ID) tiene "vencimiento" habilitado
# en Siigo Nube (p.ej. Crédito) — de lo contrario Siigo rechaza la factura
# por falta de due_date. Verificar en /v1/payment-types.
SIIGO_PAYMENT_REQUIRES_DUE_DATE=true
SIIGO_PAYMENT_DUE_DAYS=30