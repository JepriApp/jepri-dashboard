# Plantilla para el .env del servidor de staging (Tarea 3). Vive junto a
# docker-compose.yml EN EL SERVIDOR, nunca en este repo con valores reales.
#
# Build-time (Next.js las inlinea en el bundle de cliente — docker-compose las pasa
# como --build-arg, ver docker-compose.yml). SIEMPRE el self-hosted, NUNCA Neptuno:
NEXT_PUBLIC_SUPABASE_URL=http://10.85.96.51:8000
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<DEV_SUPABASE_PUBLISHABLE_KEY de tu .env.local>

# Runtime (vía env_file en docker-compose.yml) — opcional para que las pantallas de
# facturación Siigo no truenen en staging; si no te importa esa parte, deja los valores
# de ejemplo, no se usan en el flujo del bot.
SIIGO_API_ACCESS_KEY=
SIIGO_API_USERNAME=
SIIGO_API_BASE_URL=https://api.siigo.com/
SIIGO_PARTNER_ID=
SIIGO_DOCUMENT_ID=0
SIIGO_SELLER_ID=0
SIIGO_PAYMENT_ID=0
SIIGO_PAYMENT_REQUIRES_DUE_DATE=false
SIIGO_PAYMENT_DUE_DAYS=0

# Se completan a partir de la Tarea 10 (webhook de Telegram) — se pueden dejar vacíos
# hasta entonces.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OPS_CHAT_ID=
